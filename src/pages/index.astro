---
// -------------------------------------------------------------
// 【フロントマター】
// -------------------------------------------------------------
import { Image } from 'astro:assets';
import myAvatar from '../assets/my-avatar.jpg';
import Footer from '../layouts/Layout.astro'; 

const pageTitle = "Water Islandz Technologies";
const name = "Water Islandz Technologies";
const description = "Digital Life Support: A private tech & lifestyle concierge for clients";

const links = [
  { name: "X", url: "https://www.x.com" },
  { name: "Instagram", url: "https://www.instagram.com" },
  { name: "GitHub", url: "https://github.com" },
  { name: "YouTube", url: "https://www.youtube.com" },
  { name: "Facebook", url: "https://www.facebook.com" },
  { name: "note", url: "https://note.com" },
  { name: "Threads", url: "https://www.threads.com" },
  { name: "email", url: "mailto:your-email@example.com" }
];
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
</head>
<body>

  <main>
    <center>
      <br />
      <hr />
      
      <!-- 1. 写真 -->
      <Image 
        src={myAvatar} 
        alt={name} 
        width={200} 
        height={200} 
      />

      <!-- 2. 名前と短文 -->
      <h1>{name}</h1>
      <p>{description}</p>

      <hr />
      <br />
    
      <!-- 3. ビジネス -->
      <h2>Business</h2>
      <ul> 
        Tech: Web Services / PC & Smartphone Support / Networking<br />
        Design: Electronic Documents & CAD Drafting<br />
        Engineering: Electrical Work / Appliance Repair<br />
        Planning: Casual Financial Planning (FP)<br />
      </ul>

      <br />
      <hr />
      <br />

      <!-- 4. SNSなどのリンク -->
      <h2>Links</h2>
      <ul>
        {links.map((link) => (
          <>
            <a href={link.url} target="_blank" rel="noopener noreferrer">
              {link.name}
            </a>
          {' '}
          </>
        ))}
      </ul>
      
      <br />
      <hr />

      <!-- ★Footerコンポーネントを呼び出し（フッターとMode切り替えボタンがここに表示されます） -->
      <Footer />

    </center>
  </main>

</body>
</html>