---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
</head>
<body>

  <main>
    <center>
      <br />
<!--       
      // 1. アバター写真（class="avatar-img" を追加）
      <Image 
        src={myAvatar} 
        alt={name} 
        class="avatar-img"
      /> -->

      <!-- 2. 名前と短文 -->
      <h1 class="profile-name">{name}</h1>
      <p class="profile-desc">{description}</p>
      <hr />

      <!-- 3. ビジネス画像（class="business-img" を追加し直書きstyleを削除） -->
      <Image 
        src={business} 
        alt={name} 
        class="business-img"
      />
      <br />
      整備・点検<br />
      法定点検や日常のオイル,消耗品の交換<br /><br />
      修理<br />
      キズやヘコミの板金塗装やエンジンや内部部品の不具合対応<br /><br />
      車検<br />
      愛車の不調を見逃さない確実な点検・整備<br /><br />
      中古車販売<br />
      自社工場で点検・整備を行った状態の良い車を選ぶことが可能<br /><br />
      レンタカー<br />
      <a href="https://note.com/aque5302/n/n672c20a04032?app_launch=false" target="_blank" rel="noopener noreferrer">近日サービス開始</a>
      <br />
      〒904-2225沖縄県うるま市字喜屋武6-3<br />
      📞098-989-5957<br />
      🕙10:00〜19:00  ㊡日/月<br />
      <br /><br />
      <hr />
      <br />

      <!-- Links（SNSアイコン一覧） -->
      <div class="social-links">
        {links.map((link) => (
          <a 
            href={link.url} 
            target={link.url.startsWith('http') ? "_blank" : "_self"} 
            rel="noopener noreferrer" 
            class={`social-icon ${link.name.toLowerCase()}`}
            title={link.name}
            aria-label={link.name}
          >
            <svg viewBox="0 0 24 24" class="icon" set:html={link.icon} />
          </a>
        ))}
      </div>
      <br />
      
      <!-- QRコード（class="QRcode-img" を追加） -->
      <Image 
        src={QRcode} 
        alt={name} 
        class="QRcode-img"
      />        
      <br /><br /><br />

      <!-- 近況 -->
      What's New<br />
      <p style={{ fontSize: '12px' }}>{whatisnew}</p>
      <br />
      <hr />
      <br />
      <!-- Footerコンポーネント -->
      <!-- <Footer /> -->

    </center>
  </main>

</body>
</html>




<style is:global>
  /* 基本（ライトモード）の設定 */
  body {
    background-color: #f0f0f3;
    color: #222222;
    transition: background-color 0.3s ease, color 0.3s ease;
    margin: 0;
    font-family: system-ui, sans-serif;
  }
  a {
    color: #0066cc;
  }

  /* htmlに .dark クラスが付いた時の設定（ダークモード） */
  html.dark body {
    background-color: #16010af3;
    color: #e0e0e0;
  }
  html.dark a {
    color: #66b2ff;
  }
  html.dark hr {
    border-color: #333333;
  }

  /* -------------------------------------------------- */
  /* 画像のスタイル指定（PC・共通） */
  /* -------------------------------------------------- */
  .avatar-img {
    width: 50%;
    max-width: 100px;
    height: auto;
  }

  .business-img {
    width: 100%;
    max-width: 300px; /* PCでの表示サイズ */
    height: auto;
  }

  .profile-name {
    color: #2438ec; /* お好みの青色（#0000ff や #0066cc など） */
  }

  .profile-desc {
    font-size: 0.75rem; /* 標準(1rem)より少し小さいサイズ0.875rem（14px相当） */
    /* さらに小さくしたい場合は 0.8rem や 0.75rem（12px相当）に調整してください */
  }

  /* -------------------------------------------------- */
  /* Linksアイコン専用スタイル */
  /* -------------------------------------------------- */
  .social-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin: 20px 0;
  }

  .social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #e4e2e2;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .social-icon .icon {
    width: 32px;
    height: 32px;
  }

  .social-icon:hover {
    transform: translateY(-2px);
  }

  /* 各ブランドのホバー時カラー */
  .social-icon.instagram:hover { color: #e4405f; }
  .social-icon.facebook:hover { color: #1877f2; }
  .social-icon.threads:hover { color: #000000; }
  .social-icon.youtube:hover { color: #ff0000; }
  .social-icon.x:hover { color: #000000; }
  .social-icon.note:hover { color: #2cb696; }
  .social-icon.email:hover { color: #ea4335; }
  .social-icon.phone:hover { color: #34a853; }
  .social-icon.line:hover { color: #06c755; }

  /* ダークモード時のホバー調整 */
  html.dark .social-icon { color: #aaaaaa; }
  html.dark .social-icon.threads:hover,
  html.dark .social-icon.x:hover { color: #ffffff; }

  /* -------------------------------------------------- */
  /* スマホ向け設定（画面幅が 600px 以下のとき） */
  /* -------------------------------------------------- */
  @media (max-width: 600px) {
    .avatar-img {
      max-width: 120px; /* スマホ時のアバターサイズ */
    }

    .business-img {
      max-width: 85%; /* スマホ時のビジネス画像サイズ */
    }

    .social-links {
      gap: 10px; /* アイコン同士の間隔 */
    }

    main {
      padding: 0 16px; /* 画面左右の余白 */
    }
  }

  body {
    /* 背景画像の設定 */
    background-image: 
      linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
      url('../assets/skye-bridge-llc_L.jpg'); /* linear-gradient で黒の半透明（50%）を画像の上に重ねる */
    background-size: cover;          /* 画面いっぱいに引き伸ばして収める */
    background-position: center;     /* 中央寄せて表示 */
    background-repeat: no-repeat;    /* 繰り返さない */
    background-attachment: fixed;    /* スクロールしても背景を固定する */
    
    /* 文字が見づらくなるのを防ぐための全体カラー設定 */
    color: #ffffff;                  
    margin: 0;
    min-height: 100vh;
  }

</style>
