---
// -------------------------------------------------------------
// 【フロントマター】
// -------------------------------------------------------------
import { Image } from 'astro:assets';
import myAvatar from '../assets/skye-bridge-llc_3.jpg';
import business from '../assets/car1.png';
import rentalcar from '../assets/rentalcar_261001.jpg';
import QRcode from '../assets/QRcode.png';

const pageTitle = "SKYE-BRIDGE-LLC";
const name = "SKYE-BRIDGE-LLC";
const whatisnew = "2026/08/25 弊社ウエブサイトを公開";
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Google Fonts: デルタゴシック -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Dela+Gothic+One&display=swap" rel="stylesheet">

  <!-- ファビコンの設定 -->
  <link rel="icon" type="image/png" href="/favicon2.png" />
  <title>{pageTitle}</title>
</head>
<body>

  <main>
    <center>
      <!-- クラス名を正しく付与 -->
      <span class="site-title">SKYE-BRIDGE-LLC</span><br />
      <span class="sub-title">自動車特定整備事業者・沖縄県自動車整備振興会員</span>
      <br />

      <!-- ビジネス画像 -->
      <Image 
        src={business} 
        alt={name} 
        class="business-img"
      /> 
      <br />
      【整備・点検】<br />
      法定点検や日常のオイル,消耗品の交換<br /><br />
      【修理】<br />
      キズやヘコミの板金塗装やエンジンや内部部品<br /><br />
      【車検】<br />
      愛車の不調を見逃さない確実な点検,整備<br /><br />
      【中古車販売】<br />
      自社工場で点検,整備を行った状態の良い車<br /><br />
      <br />
      <b>SKYE-BRIDGE-LLC</b><br />
      〒904-2225 沖縄県うるま市字喜屋武6-3<br />
      📞098-989-5957<br />
      🕙10:00〜19:00  ㊡日<br /><br />
      <hr />

      <!-- レンタカーチラシ -->
      <Image 
        src={rentalcar} 
        alt={name} 
        class="rentalcar-img"
      />
    
      <hr />
      <br />
      <br />
      
      <!-- QRコード -->
      <Image 
        src={QRcode} 
        alt={name} 
        class="QRcode-img"
      />        
      <br /><br /><br />

      <!-- 近況 -->
      What's New<br />
      <p style="font-size: 12px;">{whatisnew}</p>
      <br />
      <hr />
      <br />
    </center>
  </main>

</body>
</html>

<style is:global>
  /* -------------------------------------------------- */
  /* 基本設定 (Body) */
  /* -------------------------------------------------- */
  body {
    /* 背景画像設定（public/skye-bridge-llc_L.jpg に配置されている前提） */
    background-image: 
      linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
      url('/skye-bridge-llc_L.jpg'); 
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
    background-color: #f0f0f3; /* 画像がない場合のフォールバック */
    
    color: #ffffff; /* 基本の文字色 */
    margin: 0;
    min-height: 100vh;
    font-family: system-ui, sans-serif;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  a {
    color: #1f74cf;
  }

  /* -------------------------------------------------- */
  /* タイトル・テキストスタイル */
  /* -------------------------------------------------- */
  /* タイトル（スマホ向け：小さめ） */
  .site-title {
    font-size: 1.4rem;
    color: #ffffff; /* 暗い背景で見えやすいよう白（または明るい色）に変更 */
    font-family: 'Dela Gothic One', sans-serif;
    text-shadow: 1px 1px 3px rgba(0,0,0,0.8);
  }

  /* サブタイトル */
  .sub-title {
    font-size: 0.80rem;
    color: #d3caca;
  }

  /* PC向けタイトル設定（画面幅601px以上） */
  @media (min-width: 601px) {
    .site-title {
      font-size: 2.4rem;
    }
  }

  /* -------------------------------------------------- */
  /* 画像サイズ設定 */
  /* -------------------------------------------------- */
  .avatar-img {
    width: 100%;
    max-width: 600px;
    height: auto;
  }

  .business-img {
    width: 100%;
    max-width: 300px;
    height: auto;
  }

  .rentalcar-img {
    width: 100%;
    max-width: 600px;
    height: auto;
  }

  .QRcode-img {
    width: 100%;
    max-width: 150px;
    height: auto;
  }

  /* スマホ向け設定（画面幅600px以下） */
  @media (max-width: 600px) {
    .avatar-img {
      max-width: 400px;
    }

    .business-img {
      max-width: 70%;
    }

    .rentalcar-img {
      width: 100%;
      max-width: 100%;
    }
    
    main {
      padding: 0 10px;
    }
  }

  /* -------------------------------------------------- */
  /* ダークモード対応 */
  /* -------------------------------------------------- */
  html.dark body {
    background-color: #16010a;
    color: #e0e0e0;
  }
  html.dark a {
    color: #66b2ff;
  }
  html.dark hr {
    border-color: #333333;
  }
</style>