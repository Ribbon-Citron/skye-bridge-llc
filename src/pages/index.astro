---
// -------------------------------------------------------------
// 【フロントマター】
// -------------------------------------------------------------
import { Image } from 'astro:assets';
import myAvatar from '../assets/skye-bridge-llc_3.jpg';
import business from '../assets/car1.png';
import rentalcar from '../assets/rentalcar_261001.jpg';
import QRcode from '../assets/QRcode.png';

const pageTitle = "SKYE-BRIDGE-LLC";
const name = "SKYE-BRIDGE-LLC";
const whatisnew = "2026/08/25 弊社ウエブサイトを公開";
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Google Fonts: デルタゴシック -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Dela+Gothic+One&display=swap" rel="stylesheet">

  <!-- ファビコンの設定 -->
  <link rel="icon" type="image/png" href="/favicon2.png" />
  <title>{pageTitle}</title>
</head>
<body>

  <main>
    <center>
      <!-- モード切り替えボタン -->
      <div class="theme-toggle-wrapper">
        <button id="theme-toggle" type="button" aria-label="テーマ切り替え">
          <span id="theme-toggle-text">🌙 ダークモード</span>
        </button>
      </div>

      <!-- メインタイトル -->
      <span class="site-title">SKYE-BRIDGE-LLC</span><br />
      <span class="sub-title">自動車特定整備事業者・沖縄県自動車整備振興会員</span>
      <br /><br />

      <!-- ビジネス画像 -->
      <Image 
        src={business} 
        alt={name} 
        class="business-img"
      /> 
      <br /><br />
      【整備・点検】<br />
      法定点検や日常のオイル,消耗品の交換<br /><br />
      【修理】<br />
      キズやヘコミの板金塗装やエンジンや内部部品<br /><br />
      【車検】<br />
      愛車の不調を見逃さない確実な点検,整備<br /><br />
      【中古車販売】<br />
      自社工場で点検,整備を行った状態の良い車<br /><br />
      <br />
      <b>SKYE-BRIDGE-LLC</b><br />
      〒904-2225 沖縄県うるま市字喜屋武6-3<br />
      📞098-989-5957<br />
      🕙10:00〜19:00  ㊡日<br /><br />
      <hr />

      <!-- レンタカーチラシ -->
      <Image 
        src={rentalcar} 
        alt={name} 
        class="rentalcar-img"
      />
    
      <hr />
      <br />
      <br />
      
      <!-- QRコード -->
      <Image 
        src={QRcode} 
        alt={name} 
        class="QRcode-img"
      />        
      <br /><br /><br />

      <!-- 近況 -->
      What's New<br />
      <p style="font-size: 12px;">{whatisnew}</p>
      <br />
      <hr />
      <br />
    </center>
  </main>

  <!-- ダークモード切り替えスクリプト -->
  <script>
    const button = document.getElementById('theme-toggle');
    const toggleText = document.getElementById('theme-toggle-text');
    
    // OSの標準設定がダークモードか判定
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const savedTheme = localStorage.getItem('theme');

    if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
      document.documentElement.classList.add('dark');
      if (toggleText) toggleText.textContent = '☀️ ライトモード';
    } else {
      document.documentElement.classList.remove('dark');
      if (toggleText) toggleText.textContent = '🌙 ダークモード';
    }

    button?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      if (toggleText) {
        toggleText.textContent = isDark ? '☀️ ライトモード' : '🌙 ダークモード';
      }
    });
  </script>
</body>
</html>

<style is:global>
  /* -------------------------------------------------- */
  /* 基本設定（ライトモード時） */
  /* -------------------------------------------------- */
  body {
    background-color: #f8f9fa; /* 明るく視認性の良い背景色 */
    color: #212529;             /* 読みやすい濃いテキスト色 */
    margin: 0;
    padding: 20px 0;
    min-height: 100vh;
    font-family: system-ui, sans-serif;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  a {
    color: #0d6efd;
  }

  hr {
    border: none;
    border-top: 1px solid #dee2e6;
    margin: 20px 0;
  }

  /* -------------------------------------------------- */
  /* タイトル・テキストスタイル（ライトモード） */
  /* -------------------------------------------------- */
  .site-title {
    font-size: 1.4rem;
    color: #080350; /* 濃い紺色でしっかり読めるように変更 */
    font-family: 'Dela Gothic One', sans-serif;
  }

  .sub-title {
    font-size: 0.80rem;
    color: #555555;
  }

  /* PC向けタイトル設定 */
  @media (min-width: 601px) {
    .site-title {
      font-size: 3.4rem;
    }
  }

  /* -------------------------------------------------- */
  /* 切り替えボタンのスタイル */
  /* -------------------------------------------------- */
  .theme-toggle-wrapper {
    margin-bottom: 15px;
  }

  #theme-toggle {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #cccccc;
    padding: 6px 14px;
    border-radius: 20px;
    cursor: pointer;
    font-size: 0.85rem;
    transition: all 0.2s ease;
  }

  #theme-toggle:hover {
    background-color: #e2e8f0;
  }

  /* -------------------------------------------------- */
  /* 画像サイズ設定 */
  /* -------------------------------------------------- */
  .avatar-img {
    width: 100%;
    max-width: 600px;
    height: auto;
  }

  .business-img {
    width: 100%;
    max-width: 300px;
    height: auto;
  }

  .rentalcar-img {
    width: 100%;
    max-width: 600px;
    height: auto;
  }

  .QRcode-img {
    width: 100%;
    max-width: 150px;
    height: auto;
  }

  /* スマホ向け余白設定 */
  @media (max-width: 600px) {
    .business-img {
      max-width: 80%;
    }

    .rentalcar-img {
      width: 100%;
      max-width: 100%;
    }
    
    main {
      padding: 0 12px;
    }
  }

  /* -------------------------------------------------- */
  /* ダークモード時のスタイル設定 */
  /* -------------------------------------------------- */
  html.dark body {
    background-color: #121212; /* 目に優しい暗めの背景 */
    color: #e0e0e0;             /* 明るいテキスト色 */
  }

  html.dark .site-title {
    color: #82aaff; /* 暗い背景で見えやすい明るい青色 */
  }

  html.dark .sub-title {
    color: #aaaaaa;
  }

  html.dark a {
    color: #66b2ff;
  }

  html.dark hr {
    border-color: #333333;
  }

  html.dark #theme-toggle {
    background-color: #2a2a2a;
    color: #ffffff;
    border-color: #444444;
  }

  html.dark #theme-toggle:hover {
    background-color: #3a3a3a;
  }
</style>