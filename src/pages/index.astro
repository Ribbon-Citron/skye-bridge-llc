---
// -------------------------------------------------------------
// 【フロントマター】ここでは将来の拡張を見据えてデータを定義します
// -------------------------------------------------------------
import { Image } from 'astro:assets';
import myAvatar from '../assets/my-avatar.jpg'; // あなたの写真をインポート

const pageTitle = "Water Islandz Technologies";
const name = "Water Islandz Technologies";
const description = "Digital Life Support: A private tech & lifestyle concierge for clients" ;

// SNSやリンクのデータをまとめた配列（追加・削除が簡単です）
const links = [
  { name: "X", url: "https://www.x.com" },
  { name: "Instagram", url: "https://www.instagram.com" },
  { name: "GitHub", url: "https://github.com" },
  { name: "YouTube", url: "https://www.youtube.com" },
  { name: "Facebook", url: "https://www.facebook.com" },
  { name: "note", url: "https://note.com" },
  { name: "Threads", url: "https://www.threads.com" },
  { name: "email", url: "mailto:your-email@example.com" }
  { name: "LINE", url: "mailto:your-email@example.com" }
  { name: "Phone", url: "mailto:your-email@example.com" }
];
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
</head>
<body>

  <main>
    <center>
    <!-- 1.写真（Astroが自動でWebP等に最適化・軽量化してくれます） -->
    <Image 
      src={myAvatar} 
      alt={name} 
      width={300} 
      height={300} 
    />

    <!-- 2. 名前と短文 -->
    <h1>{name}</h1>
    <p>{description}</p>

    <hr />

    <!-- 3. SNSなどのリンク（5点のリンクをループ処理で出力） -->
    <h2>Links</h2>
    <ul>
      {links.map((link) => (
        <>
          <a href={link.url} target="_blank" rel="noopener noreferrer">
            {link.name}
          </a>
        {' '}
        </>
     ))}
    </ul>

  <br />
  
  <!-- 4. ビジネス -->
    <h2>Business</h2>
    <ul> 
      <li>Tech: Web Services / PC & Smartphone Support / Networking</li>
      <li>Design: Electronic Documents & CAD Drafting</li>
      <li>Engineering: Electrical Work / Appliance Repair</li>
      <li>Planning: Casual Financial Planning (FP)</li>
    </ul>

  </center>
  </main>

</body>
</html>

