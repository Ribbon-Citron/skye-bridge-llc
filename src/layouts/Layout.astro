<!-- テーマ切り替えボタン（画面右上に固定表示） -->
<button 
    onclick="document.documentElement.classList.toggle('dark'); localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light')" 
    style="position: fixed; top: 16px; right: 16px; z-index: 9999; cursor: pointer; padding: 6px 12px; border-radius: 20px; border: 1px solid #ccc; background: rgba(255,255,255,0.8); color: #111; font-size: 13px; font-weight: 500; box-shadow: 0 2px 8px rgba(0,0,0,0.1); backdrop-filter: blur(4px);"
>
    🌓 Mode
</button>

<script is:inline>
    // ページ読み込み時に前回の設定を復元
    const theme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    if (theme === 'dark') document.documentElement.classList.add('dark');
</script>

<style>
    /* クレジット全体のスタイル */
    .site-credit {
        margin-top: auto;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        font-family: system-ui, sans-serif;
        font-size: 13px;
        color: #777;
        padding: 20px;
    }
    .credit-links { display: flex; align-items: center; gap: 8px; }
    .item {
        display: flex; align-items: center; gap: 4px; color: #777;
        text-decoration: none; transition: all 0.2s; font-weight: 500;
    }
    .item svg { width: 16px; height: 16px; }
    .sep { color: #ccc; font-size: 11px; user-select: none; }

    /* ホバー時のブランドカラー */
    .item:hover { transform: translateY(-1px); }
    .astro:hover { color: #ff5d01; }
    .cf:hover { color: #f38020; }
    .github:hover { color: #111111; }

    /* ダークモード時のクレジットの色調整 */
    :global(.dark) .site-credit, :global(.dark) .item {
        color: #999;
    }
    :global(.dark) .sep {
        color: #444;
    }
    :global(.dark) .github:hover {
        color: #ffffff;
    }
</style>